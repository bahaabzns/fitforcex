DB_USER=postgres
DB_HOST=localhost
DB_NAME=fitforce-x-database
DB_PASSWORD=
DB_PORT=5432
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
PORT=4000
JWT_SECRET=
ADMIN_JWT_SECRET=
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SENTRY_DSN=          # Get from sentry.io → Project → Settings → Client Keys (DSN)

S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=fitforce-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=       # Optional: public CDN base URL for exercise media (e.g. https://pub-xxx.r2.dev)

FAWATERAK_API_KEY=
FAWATERAK_SECRET_KEY=
FAWATERAK_BASE_URL=https://app.fawaterak.com/api/v2

# SMTP — password reset / email verification codes.
# Leave SMTP_HOST/USER/PASS blank in dev to log codes to the server console instead of sending.
# Gmail: SMTP_HOST=smtp.gmail.com, PORT=587, SECURE=false, USER=<you>@gmail.com,
#        PASS=<16-char App Password> (myaccount.google.com → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
