DB_USER=postgres
DB_HOST=localhost
DB_NAME=fitforce-x-database
DB_PASSWORD=
DB_PORT=5432
# connection_limit/pool_timeout are explicit because Prisma's auto default
# (num_cpus * 2 + 1) can land as low as 3 on a constrained VPS, which times
# out under any real concurrent load. Size connection_limit comfortably
# below Postgres's max_connections (`SHOW max_connections;`).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME?connection_limit=15&pool_timeout=20
PORT=4000
HOST=127.0.0.1   # set to 0.0.0.0 to test from a physical device on your LAN
JWT_SECRET=
ADMIN_JWT_SECRET=
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SENTRY_DSN=          # Get from sentry.io → Project → Settings → Client Keys (DSN)

S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=fitforce-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=       # Optional: public CDN base URL for exercise media (e.g. https://pub-xxx.r2.dev)

# Paymob Accept API — accept.paymob.com dashboard → Settings → Account Info (API key) /
# Payment Integrations (integration IDs, one per method) / iFrames (iframe id) / HMAC.
# Leave blank in dev — checkout requests fail cleanly with a user-facing error until set.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_FAWRY=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

# Manual-transfer checkout (InstaPay / mobile wallet, verified by an admin over WhatsApp
# within 24h) — shown as-is on the checkout page, so keep these accurate.
INSTAPAY_HANDLE=
WALLET_VODAFONE_CASH=
WALLET_ETISALAT_CASH=
WALLET_ORANGE_CASH=
WALLET_WE_PAY=
MANUAL_PAYMENT_BENEFICIARY_NAME=
WHATSAPP_VERIFICATION_NUMBER=201501233314

# SMTP — password reset / email verification codes.
# Leave SMTP_HOST/USER/PASS blank in dev to log codes to the server console instead of sending.
# Gmail: SMTP_HOST=smtp.gmail.com, PORT=587, SECURE=false, USER=<you>@gmail.com,
#        PASS=<16-char App Password> (myaccount.google.com → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
