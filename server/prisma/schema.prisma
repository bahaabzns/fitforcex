  workspaces                   workspaces                     @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_packages_workspace")
}

// Subscription Access Policy — what an Expired or Frozen client may still see/do.
// One row per (workspace, scope) is the global default (package_id NULL); a row with
// package_id set overrides the global for that package + scope. See utils/subscriptionPolicy.ts.
model subscription_access_policies {
  id                         String     @id
  workspace_id               String
  package_id                 String?
  scope                      String // 'expired' | 'frozen'
  keep_portal_access         Boolean    @default(true)
  view_training_plans        Boolean    @default(true)
  view_nutrition_plans       Boolean    @default(true)
  view_progress_history      Boolean    @default(true)
  view_assessments           Boolean    @default(true)
  view_checkins              Boolean    @default(true)
  allow_messaging            Boolean    @default(false)
  allow_submit_checkins      Boolean    @default(false)
  allow_booking_appointments Boolean    @default(false)
  allow_download_files       Boolean    @default(false)
  grace_period_days          Int        @default(0)
  created_at                 DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?  @default(now()) @db.Timestamptz(6)
  packages                   packages?  @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces                 workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id], map: "idx_sub_policy_workspace")
  @@index([package_id], map: "idx_sub_policy_package")
}

// Audit trail for subscription policy edits ('policy.update') and automatic status
// transitions ('status.change', actor_type 'system'). Not FK-constrained on purpose:
// system events have no user actor and the client may be hard-deleted.
model subscription_status_audit {
  id            String   @id
  workspace_id  String
  client_id     String?
  actor_type    String // 'coach' | 'system'
  actor_user_id String?
  event_type    String // 'policy.update' | 'status.change'
  from_status   String?
  to_status     String?
  metadata      Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([workspace_id, created_at(sort: Desc)], map: "idx_sub_audit_workspace")
  @@index([client_id], map: "idx_sub_audit_client")
}

// Durable per-recipient notification surface (the bell). Written by recordEvent()
// in lib/events.ts, the single choke point for domain events. Not FK-constrained
// on the recipient on purpose: recipients can be a user OR a client, and either
// may be hard-deleted; the workspace FK cascades cleanup.
model notifications {
  id             String    @id
  workspace_id   String
  recipient_type String // 'user' | 'client'
  recipient_id   String
  type           String // event key, e.g. 'message.received'
  importance     String    @default("info") // 'info' | 'actionable' | 'alert'
  title          String
  body           String?
  entity_type    String?
  entity_id      String?
  actor_type     String?
  actor_id       String?
  metadata       Json?
  read_at        DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([recipient_type, recipient_id, read_at, created_at(sort: Desc)], map: "idx_notifications_recipient")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_notifications_workspace")
}

