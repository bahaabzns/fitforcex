generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admins {
  id         String   @id
  email      String   @unique
  password   String
  fname      String?
  lname      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model billing_discounts {
  id                String              @id
  period_key        String              @unique
  label             String
  save_label        String?
  discount_percent  Int                 @default(0)
  months            Int                 @default(1)
  sort_order        Int                 @default(0)
  is_active         Boolean             @default(true)
  plan_period_links plan_period_links[]
}

model client_measurements {
  id             String    @id
  client_id      String?   @unique
  gender         String?   @db.VarChar(20)
  activity_level String?   @db.VarChar(50)
  date_of_birth  DateTime? @db.Date
  weight         Decimal?  @db.Decimal(6, 2)
  height         Decimal?  @db.Decimal(6, 2)
  neck           Decimal?  @db.Decimal(6, 2)
  waist          Decimal?  @db.Decimal(6, 2)
  hip            Decimal?  @db.Decimal(6, 2)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  clients        clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model client_observations {
  id                  String            @id
  client_id           String
  workspace_id        String
  author_id           String?
  title               String
  content             String? // optional "Details" — elaboration beyond the title
  category            String            @default("General")
  severity            String? // 'Low' | 'Medium' | 'High'
  exercise_library_id String?
  food_item_id        String?
  form_request_id     String?
  attachment_url      String?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?         @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?         @db.Timestamptz(6)
  users               users?            @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  clients             clients           @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces          workspaces        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercise_library    exercise_library? @relation(fields: [exercise_library_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  food_items          food_items?       @relation(fields: [food_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  form_requests       form_requests?    @relation(fields: [form_request_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Superseded by observation_relations (below) — kept only until the follow-up
  // migration that drops these three columns once the cutover is verified.
  observation_relations observation_relations[]

  @@index([client_id], map: "client_observations_client_id_index")
  @@index([workspace_id], map: "client_observations_workspace_id_index")
  @@index([client_id, deleted_at, created_at(sort: Desc)], map: "idx_observations_client_feed")
  @@index([category], map: "idx_observations_category")
  @@index([exercise_library_id], map: "idx_observations_exercise_library_id")
  @@index([food_item_id], map: "idx_observations_food_item_id")
  @@index([form_request_id], map: "idx_observations_form_request_id")
}

// Junction table letting one observation link to multiple entities — each row
// is a single link (exactly one of the three FK columns set, enforced in the
// controller). Replaces client_observations' single exercise_library_id /
// food_item_id / form_request_id columns above, which are kept temporarily
// for a safe rollback window.
model observation_relations {
  id                  String              @id
  observation_id      String
  exercise_library_id String?
  food_item_id        String?
  form_request_id     String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)

  client_observations client_observations @relation(fields: [observation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercise_library    exercise_library?   @relation(fields: [exercise_library_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  food_items          food_items?         @relation(fields: [food_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  form_requests       form_requests?      @relation(fields: [form_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([observation_id, exercise_library_id], map: "uq_observation_relations_exercise")
  @@unique([observation_id, food_item_id], map: "uq_observation_relations_food_item")
  @@unique([observation_id, form_request_id], map: "uq_observation_relations_form_request")
  @@index([observation_id], map: "idx_observation_relations_observation_id")
  @@index([exercise_library_id], map: "idx_observation_relations_exercise_library_id")
  @@index([food_item_id], map: "idx_observation_relations_food_item_id")
  @@index([form_request_id], map: "idx_observation_relations_form_request_id")
}

model client_photos {
  id          String    @id
  client_id   String?
  photo_type  String    @db.VarChar(20)
  file_path   String    @db.VarChar(500)
  uploaded_at DateTime? @default(now()) @db.Timestamptz(6)
  clients     clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Package Lifecycle — recurring check-in dispatch rows, created at plan
// activation (nutrition/training controllers) and ticked forward by the
// scheduler (middleware/scheduler.ts). FKs are enforced at the DB level via
// migration 032; not modeled as Prisma relations here, matching how
// training_plans.client_id is already a plain column in this schema.
model check_in_schedules {
  id               String    @id
  workspace_id     String
  client_id        String
  form_id          String
  next_due_at      DateTime  @db.Timestamptz(6)
  source_plan_type String // 'nutrition' | 'training'
  source_plan_id   String
  paused_at        DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  // Bug fix: the form_requests row is now created immediately at activation
  // (status 'scheduled', visible in Plans Queue right away) instead of only
  // once this row becomes due. This links back to it so restart/extend can
  // retarget its scheduled_at and the dispatch tick can flip its status
  // instead of creating a duplicate. Plain column + DB-level FK (migration
  // 040), matching the convention already used by client_id/form_id above.
  form_request_id  String?   @unique

  @@index([next_due_at], map: "idx_checkin_sched_due")
  @@index([client_id], map: "idx_checkin_sched_client")
  @@index([form_id])
}

model clients {
  id                   String                 @id
  client_code          Int
  fname                String                 @db.VarChar(100)
  lname                String                 @db.VarChar(100)
  email                String                 @db.VarChar(150)
  phone                String?                @db.VarChar(20)
  workspace_id         String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  password             String?                @db.VarChar(255)
  phones               Json?                  @default("[]")
  current_package      String?
  current_package_variation_id String?
  subscription_status  String                 @default("Active")
  archived_at          DateTime?              @db.Timestamptz(6)
  archived_by          String?
  restored_at          DateTime?              @db.Timestamptz(6)
  restored_by          String?
  deleted_at           DateTime?              @db.Timestamptz(6)
  deleted_by           String?
  client_measurements  client_measurements?
  client_observations  client_observations[]
  client_photos        client_photos[]
  workspaces           workspaces?            @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clients_workspace")
  package_variations   package_variations?    @relation(fields: [current_package_variation_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_clients_current_package_variation")
  form_requests        form_requests[]
  nutrition_plans      nutrition_plans[]
  subscription_freezes subscription_freezes[]
  transactions         transactions[]
  workout_logs         workout_logs[]

  @@unique([workspace_id, client_code], map: "clients_coach_id_client_code_key")
  @@unique([workspace_id, email])
  @@index([workspace_id, archived_at], map: "idx_clients_ws_archived")
}

model exercise_equipments {
  id           String     @id
  workspace_id String
  name_en      String
  name_ar      String?
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exercise_equipments_workspace")

  @@unique([workspace_id, name_en], map: "exercise_equipments_coach_id_name_key")
  @@index([workspace_id], map: "idx_exercise_equipments_coach")
}

model exercise_library {
  id                             String                           @id
  workspace_id                   String
  name_en                        String
  muscle_group                   String?
  equipment                      String?
  youtube_url                    String?
  video_path                     String?
  thumbnail_path                 String?
  instructions_en                String?
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  name_ar                        String?
  instructions_ar                String?
  workspaces                     workspaces                       @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exercise_library_workspace")
  training_exercise_alternatives training_exercise_alternatives[]
  training_exercises             training_exercises[]
  client_observations            client_observations[]
  observation_relations          observation_relations[]

  @@index([workspace_id], map: "idx_exercise_library_coach")
}

model exercise_muscle_groups {
  id           String     @id
  workspace_id String
  name_en      String
  name_ar      String?
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exercise_muscle_groups_workspace")

  @@unique([workspace_id, name_en], map: "exercise_muscle_groups_coach_id_name_key")
  @@index([workspace_id], map: "idx_exercise_muscle_groups_coach")
}

model food_categories {
  id           String      @id
  name_en      String      @db.VarChar(100)
  workspace_id String?
  name_ar      String?     @db.VarChar(100)
  workspaces   workspaces? @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_food_categories_workspace")
}

model food_items {
  id                               String                             @id
  name_en                          String                             @db.VarChar(255)
  calories_per_serving             Decimal                            @db.Decimal
  protein_per_serving              Decimal                            @db.Decimal
  carbs_per_serving                Decimal                            @db.Decimal
  fats_per_serving                 Decimal                            @db.Decimal
  workspace_id                     String?
  food_category                    String?
  serving_size                     Decimal?                           @db.Decimal
  serving_unit                     String?
  name_ar                          String?                            @db.VarChar(255)
  workspaces                       workspaces?                        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_food_items_workspace")
  nutrition_meal_item_alternatives nutrition_meal_item_alternatives[]
  nutrition_meal_items             nutrition_meal_items[]
  client_observations              client_observations[]
  observation_relations            observation_relations[]
}

// ── Default Libraries (global master set, owned by Super Admin) ─────────────────
// Cloned into workspace-scoped tables on coach account creation. Not tenant-scoped.

model master_exercise_muscle_groups {
  id         String   @id
  name_en    String   @unique
  name_ar    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model master_exercise_equipments {
  id         String   @id
  name_en    String   @unique
  name_ar    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model master_exercise_library {
  id              String   @id
  name_en         String
  name_ar         String?
  muscle_group    String?
  equipment       String?
  youtube_url     String?
  video_path      String?
  thumbnail_path  String?
  instructions_en String?
  instructions_ar String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([name_en])
  @@index([muscle_group])
}

model master_food_categories {
  id         String   @id
  name_en    String   @unique @db.VarChar(100)
  name_ar    String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model master_food_items {
  id                   String   @id
  name_en              String   @db.VarChar(255)
  name_ar              String?  @db.VarChar(255)
  food_category        String?
  serving_size         Decimal? @db.Decimal
  serving_unit         String?
  calories_per_serving Decimal  @default(0) @db.Decimal
  protein_per_serving  Decimal  @default(0) @db.Decimal
  carbs_per_serving    Decimal  @default(0) @db.Decimal
  fats_per_serving     Decimal  @default(0) @db.Decimal
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)

  @@index([name_en])
  @@index([food_category])
}

// Master Form Templates — global default Assessment & Check-In forms owned by the
// Super Admin. Cloned into workspace-scoped forms / form_questions on coach signup
// (see lib/libraryClone.ts). Not workspace-scoped: the single global master set.

model master_forms {
  id             String                  @id
  title_en       String                  @default("Untitled Form") @db.VarChar(255)
  title_ar       String?                 @db.VarChar(255)
  description_en String?
  description_ar String?
  status         String                  @default("draft") @db.VarChar(20)
  post_action    String                  @default("nothing")
  form_type      String                  @default("check-in")
  created_at     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                @default(now()) @db.Timestamptz(6)
  questions      master_form_questions[]

  @@index([form_type])
}

model master_form_questions {
  id             String       @id
  master_form_id String
  label_en       String       @default("Question")
  label_ar       String?
  type           String       @default("text") @db.VarChar(30)
  required       Boolean      @default(false)
  order_index    Int          @default(0)
  options        Json?
  options_ar     Json?
  placeholder_en String?
  placeholder_ar String?
  min_value      Int?
  max_value      Int?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  master_forms   master_forms @relation(fields: [master_form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([master_form_id])
}

// form_questions was retired in Forms Versioning Phase 4 (migration 039) —
// fully superseded by form_versions/form_version_questions. See
// docs/forms-architecture-investigation.md and
// docs/forms-versioning-implementation-plan.md.

model form_requests {
  id                  String                @id
  form_id             String?
  client_id           String?
  workspace_id        String
  status              String?               @default("pending") @db.VarChar(20)
  requested_at        DateTime?             @default(now()) @db.Timestamp(6)
  submitted_at        DateTime?             @db.Timestamp(6)
  post_action         String                @default("nothing")
  scheduled_at        DateTime?             @db.Timestamptz(6)
  action_taken_at     DateTime?             @db.Timestamptz(6)
  assigned_to         String? // user id of the team member this request is assigned to
  form_version_id     String? // Forms Versioning — the version pinned at creation time; never changes after
  workspaces          workspaces            @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_form_requests_workspace")
  clients             clients?              @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  forms               forms?                @relation(fields: [form_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  form_versions       form_versions?        @relation(fields: [form_version_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  form_responses      form_responses[]
  client_observations client_observations[]
  observation_relations observation_relations[]

  @@index([assigned_to])
  @@index([form_id])
  @@index([form_version_id])
}

model form_responses {
  id             String          @id
  request_id     String?
  question_id    String?
  answer         String?
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  metric_id      String?
  form_version_questions form_version_questions? @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  form_requests  form_requests?  @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  metrics        metrics?        @relation(fields: [metric_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([metric_id])
  @@index([request_id, metric_id])
  @@index([question_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model forms {
  id                 String           @id
  workspace_id       String
  title_en           String           @default("Untitled Form") @db.VarChar(255)
  description_en     String?
  status             String           @default("draft") @db.VarChar(20)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @db.Timestamptz(6)
  post_action        String           @default("nothing")
  form_type          String           @default("check-in")
  title_ar           String?          @db.VarChar(255)
  description_ar     String?
  current_version_id String? // Forms Versioning — the version coaches currently edit/assign; NULL only pre-backfill
  form_requests      form_requests[]
  package_default_forms package_default_forms[]
  workspaces         workspaces       @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_forms_workspace")
  form_versions      form_versions[]  @relation("FormVersionsByForm")
  current_version    form_versions?   @relation("FormCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([current_version_id])
}

model form_versions {
  id             String           @id
  form_id        String
  version_number Int
  sealed_at      DateTime?        @db.Timestamptz(6) // NULL = still an editable draft
  created_by     String? // user id; NULL for system/scheduler-triggered forks
  change_note    String? // reserved for a future manual-publish UI; unused today
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  forms          forms            @relation("FormVersionsByForm", fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  current_of_forms       forms[]                 @relation("FormCurrentVersion")
  form_version_questions form_version_questions[]
  form_requests          form_requests[]

  @@unique([form_id, version_number])
  @@index([form_id])
}

model form_version_questions {
  id             String        @id
  form_version_id String
  label_en       String        @default("Question")
  label_ar       String?
  type           String        @default("text") @db.VarChar(30)
  required       Boolean       @default(false)
  order_index    Int           @default(0)
  options        Json?
  options_ar     Json?
  placeholder_en String?
  placeholder_ar String?
  min_value      Int?
  max_value      Int?
  metric_id      String?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  form_versions  form_versions @relation(fields: [form_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  metrics        metrics?      @relation(fields: [metric_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  form_responses form_responses[]

  @@index([form_version_id])
  @@index([metric_id])
}

model metrics {
  id             String           @id
  workspace_id   String
  name           String
  type           String           @db.VarChar(20)
  unit           String?          @db.VarChar(50)
  icon           String?          @db.VarChar(100)
  description    String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?        @db.Timestamptz(6)
  workspaces     workspaces       @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  form_responses form_responses[]
  form_version_questions form_version_questions[]

  @@unique([workspace_id, name])
  @@index([workspace_id, deleted_at])
}

model messages {
  id                  String    @id
  thread_id           String
  sender_type         String
  sender_id           String
  body                String?
  type                String    @default("text") // "text" | "image" | "voice" | "file"
  attachment_url      String?
  attachment_name     String?
  attachment_size     Int?
  attachment_mime     String?
  attachment_duration Int? // seconds, voice notes only
  edited_at           DateTime? @db.Timestamptz(6)
  deleted_at          DateTime? @db.Timestamptz(6)
  read_by_team_at     DateTime? @db.Timestamptz(6)
  read_by_client_at   DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([thread_id])
}

model nutrition_cycles {
  id              String            @id
  plan_id         String?
  name            String            @default("Cycle 1")
  cycle_order     Int               @default(1)
  goal_calories   Int?
  goal_protein    Int?
  goal_carbs      Int?
  goal_fats       Int?
  note            String?
  nutrition_plans nutrition_plans?  @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nutrition_meals nutrition_meals[]
}

model nutrition_meal_item_alternatives {
  id                   String                @id
  meal_item_id         String?
  food_item_id         String?
  amount               Decimal               @db.Decimal
  alt_order            Int                   @default(1)
  food_items           food_items?           @relation(fields: [food_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nutrition_meal_items nutrition_meal_items? @relation(fields: [meal_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model nutrition_meal_items {
  id                               String                             @id
  meal_id                          String?
  food_item_id                     String?
  amount                           Decimal                            @default(100) @db.Decimal
  meal_item_order                  Int
  nutrition_meal_item_alternatives nutrition_meal_item_alternatives[]
  food_items                       food_items?                        @relation(fields: [food_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nutrition_meals                  nutrition_meals?                   @relation(fields: [meal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model nutrition_meals {
  id                   String                 @id
  cycle_id             String?
  name                 String
  meal_order           Int                    @default(1)
  note                 String?
  nutrition_meal_items nutrition_meal_items[]
  nutrition_cycles     nutrition_cycles?      @relation(fields: [cycle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model nutrition_plans {
  id                  String             @id
  name                String
  client_id           String?
  workspace_id        String?
  status              String?            @default("draft")
  created_at          DateTime?          @default(now()) @db.Timestamp(6)
  updated_at          DateTime?          @default(now()) @db.Timestamp(6)
  activated_at        DateTime?          @db.Timestamptz(6)
  created_by          String?
  cycle_days          Int?
  cycle_end_at        DateTime?          @db.Timestamptz(6)
  review_notified_at  DateTime?          @db.Timestamptz(6)
  review_offset_days  Int?
  nutrition_cycles nutrition_cycles[]
  workspaces       workspaces?        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_nutrition_plans_workspace")
  clients          clients?           @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?             @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model package_variations {
  id                    String                 @id
  package_id            String
  name                  String
  description           String?
  duration              Int
  price                 Decimal                @db.Decimal(12, 2)
  currency              String                 @default("USD")
