// Package Lifecycle — default forms proposed at client-creation
// (kind=assessment) or plan-activation (kind=checkin-nutrition |
// checkin-training, one-shot) time. Read only at the moment of the
// triggering action, never re-read live afterward. checkin-nutrition/
// checkin-training were split from a single 'checkin' kind (migration 042)
// so a package's check-in defaults can differ by plan type.
model package_default_forms {
  id                   String             @id
  package_variation_id String
  form_id              String
  kind                 String // 'assessment' | 'checkin-nutrition' | 'checkin-training'
  sort_order           Int                @default(1)
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  package_variations   package_variations @relation(fields: [package_variation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  forms                forms              @relation(fields: [form_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([package_variation_id], map: "idx_pkg_default_forms_variation")
  @@index([form_id], map: "idx_pkg_default_forms_form")
}

