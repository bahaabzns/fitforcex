# Mobile build-time configuration.
# These are passed at build/run time via --dart-define (NOT read from a file at runtime).
# Copy the values you need into a launch config or a --dart-define-from-file JSON.
#
# Example:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5000 --dart-define=FLAVOR=dev
#
# Android emulator reaches the host machine at 10.0.2.2; iOS simulator uses localhost.

# Base URL of the FitForce X API (no trailing slash). The app appends /api/client-portal/*.
API_BASE_URL=http://10.0.2.2:5000

# Flavor: dev | staging | prod
FLAVOR=dev

# Optional: default workspace slug to prefill on the login screen (dev convenience only)
DEFAULT_WORKSPACE_SLUG=
